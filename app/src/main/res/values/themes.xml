<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Compose theme is the real one (see Theme.kt). This exists only so the window
      background matches the app's colours instead of flashing the platform default before
      Compose takes over.
    -->
    <style name="Theme.Dev2go" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>